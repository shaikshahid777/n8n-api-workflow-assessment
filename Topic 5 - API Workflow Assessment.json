    {
      "parameters": {
        "jsCode": "const posts = $input.all().map(i => i.json);\nconst user = $('Get User').first().json;\nconst ctx = $('Prepare Request Context').first().json;\n\nconst result = {\n  requestId: ctx.requestId,\n  requestTimestamp: ctx.requestTimestamp,\n  completedAt: new Date().toISOString(),\n  executionId: $execution.id,\n  executionMode: $execution.mode,\n  workflowId: $workflow.id,\n  workflowName: $workflow.name,\n  user: { id: user.id, name: user.name, email: user.email },\n  postCount: posts.length,\n  postTitles: posts.map(p => p.title),\n};\n\nconsole.log('[EXEC ' + $execution.id + '] ' + result.requestId + ' user=' + result.user.name + ' posts=' + result.postCount + ' at ' + result.completedAt);\n\nreturn [{ json: result }];"
